{
  "name": "axis-app",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "next dev",
    "dev:backend": "nodemon --watch src --ext ts --exec \"ts-node --project tsconfig.backend.json -r tsconfig-paths/register\" src/server.ts",
    "build": "tsc -p tsconfig.backend.json && tsc-alias -p tsconfig.backend.json",
    "build:frontend": "next build",
    "start": "node dist/server.js",
    "start:frontend": "next start",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-select": "^2.3.5",
    "@rainbow-me/rainbowkit": "2.1.3",
    "@tanstack/react-query": "^5.101.4",
    "@x402/core": "^2.21.0",
    "@x402/evm": "^2.21.0",
    "@x402/svm": "^2.21.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.17.0",
    "express": "^4.19.2",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.25",
    "lucide-react": "^1.29.0",
    "morgan": "^1.10.0",
    "next": "^16.2.10",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.13",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.55.11",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "nodemon": "^3.1.4",
    "postcss": "^8.5.21",
    "prisma": "^5.18.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
