# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS and OAuth redirect)
FRONTEND_URL="http://localhost:3000"

# Database connection string for MySQL
DATABASE_URL="mysql://root:xxxxx@localhost:3306/db_chatbot"

# GROQ API key for Sanity or related service
GROQ_API_KEY="xxxxx"

# JWT
JWT_SECRET="xxxxx"
JWT_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID="xxxxx"
GOOGLE_CLIENT_SECRET="xxxxx"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# GitHub OAuth
GITHUB_CLIENT_ID="xxxxx"
GITHUB_CLIENT_SECRET="xxxxx"
GITHUB_CALLBACK_URL="http://localhost:5000/api/auth/github/callback"

# Gmail / SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="xxxxx"
SMTP_PASS="xxxxx"
SMTP_FROM="xxxxx"

# Encryption Key (32 bytes hex string)
ENCRYPTION_KEY="xxxxx"

# WalletConnect Project ID (https://cloud.walletconnect.com/)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="xxxxx"
